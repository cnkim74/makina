/**
 * Cloudflare Workers 설정.
 * 빌드: npm run cf:build   미리보기: npm run cf:preview   배포: npm run cf:deploy
 * 문서: https://opennext.js.org/cloudflare
 *
 * CMS(관리자 화면)는 D1 데이터베이스(DB)와 R2 저장소(MEDIA)를 쓴다.
 * - 운영: Cloudflare 의 D1 "makina-db" 와 R2 "makina-media" 에 연결되어 있다. (README "관리자(CMS)")
 *   배포 명령에서 `wrangler d1 migrations apply makina-db --remote` 로 스키마를 먼저 맞춘다.
 * - 개발: env.dev 의 로컬 D1·R2 를 쓴다. `npm run db:migrate:local` 후 `npm run dev`.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "makina",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "makina"
    }
  ],

  // ── 운영 연결 ──
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "makina-db",
      "database_id": "090ea305-2361-4bd7-bf42-31740e08d43e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "makina-media" }],

  "env": {
    // 로컬 개발용 — 실제 Cloudflare 자원 없이 .wrangler/state 에 저장된다
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "makina-db",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "makina-media" }]
    }
  }
}
